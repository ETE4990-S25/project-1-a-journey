class Character:
    def __init__(self, name, max_health, health=None):
        self.name = name
        self.max_health = max_health
        self.health = health if health is not None else max_health  # Default to full health

    def get_status(self):
        print(f"{self.name}'s Health: {self.health}/{self.max_health}")

class HealingItem:
    def __init__(self, healing_amount):
        self.healing_amount = healing_amount

    def heal(self, character):
        if character.health < character.max_health:
            character.health = min(character.health + self.healing_amount, character.max_health)
            print(f"{character.name} healed for {self.healing_amount} HP. Current health: {character.health}/{character.max_health}")
        else:
            print(f"{character.name} is already at full health!")

class PoisonEffect:
    def __init__(self, damage_amount):
        self.damage_amount = damage_amount

    def apply(self, character):
        character.health = max(character.health - self.damage_amount, 0)
        print(f"{character.name} took {self.damage_amount} poison damage. Current health: {character.health}/{character.max_health}")

# Test Code
if __name__ == "__main__":
    player = Character("Hero", 100, 50)
    player.get_status()

    potion = HealingItem(20)
    potion.heal(player)
    
    poison = PoisonEffect(30)
    poison.apply(player)
    poison.apply(player)
