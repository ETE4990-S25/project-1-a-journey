        self.name = name
        self.char_class = char_class
        self.health = 100
        self.strength = 80 if char_class == "Knight" else 60
        self.inventory = ["Rusty Sword", "Health Potion"]
        self.level = 1
        self.xp = 0

    def attack(self, enemy):
        damage = random.randint(self.strength // 2, self.strength)
        if random.random() < 0.2:  # 20% chance for a critical hit
            damage *= 1.5
            print(f"Critical hit! {self.name} deals {int(damage)} damage!")
        else:
            print(f"{self.name} swings their sword, dealing {int(damage)} damage!")
        enemy.health -= int(damage)

    def level_up(self):
        if self.xp >= 100:
            self.level += 1
            self.health += 10
            self.strength += 5
            self.xp = 0
            print(f"{self.name} leveled up! Health and Strength increased!")

    def use_item(self, item):
        if item == "Health Potion" and item in self.inventory:
            self.health += 30
            print(f"{self.name} used a Health Potion and recovered 30 HP!")
            self.inventory.remove(item)
        else:
            print("Invalid item or not in inventory!")

